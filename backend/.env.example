# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/society_db
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET_KEY=super-secret-jwt-key-change-me
ADMIN_REGISTRATION_SECRET=super-secret-admin-key-change-me

# Environment & Infrastructure Providers
ENV=development
LOG_LEVEL=INFO
EMAIL_PROVIDER=resend
CACHE_PROVIDER=memory

# Email Provider API Keys
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=
EMAIL_FROM=onboarding@resend.dev
APP_BASE_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated)
# In production: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# External Integrations & Payment Gateways (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
