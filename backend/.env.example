# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/society_db
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET_KEY=super-secret-jwt-key-change-me
ADMIN_REGISTRATION_SECRET=super-secret-admin-key-change-me

# Environment & Infrastructure Providers
ENV=development
LOG_LEVEL=INFO
EMAIL_PROVIDER=resend
CACHE_PROVIDER=memory

# Email Provider Configuration (smtp, resend, sendgrid, console)
EMAIL_PROVIDER=smtp
EMAIL_FROM=mrajpurohit1912@gmail.com
APP_BASE_URL=https://society-management-system-roan.vercel.app

# SMTP Settings (Gmail, SES, SendGrid SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mrajpurohit1912@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_USE_TLS=true

# Resend / SendGrid API Keys (if using resend/sendgrid)
RESEND_API_KEY=
SENDGRID_API_KEY=

# CORS Allowed Origins (Comma-separated)
# In production: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# External Integrations & Payment Gateways (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
